generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShortLink {
  id         String   @id @default(uuid())
  originalUrl String   @db.Text
  alias       String   @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  visitCount  Int      @default(0)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now())
  links     ShortLink[]
}

enum UserRole {
  ADMIN
  USER
}

